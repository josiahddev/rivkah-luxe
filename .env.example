# RIVKAH LUXE — environment variables. Copy to .env and fill in. Never commit real secrets.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, Prisma Postgres…). Optional ?schema=name is honoured.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Public URL of the site (used in emails, payment redirects, sitemap)
NEXT_PUBLIC_SITE_URL="https://www.rivkahluxe.com"
NEXT_PUBLIC_STORE_TIMEZONE="America/Toronto"

# Random 32+ character secret
AUTH_SECRET=""

# Stripe (cards in CAD/USD/…): dashboard.stripe.com → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Paystack (naira): dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=""

# Development only: simulate payments without real keys. Never set in production.
PAYMENT_TEST_MODE=""

# Email (any SMTP provider: Resend, Postmark, Zoho, Google Workspace…)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="orders@rivkahluxe.com"

# Image storage (Vercel → Storage → Blob). Without it, uploads go to /public/uploads in development only.
BLOB_READ_WRITE_TOKEN=""

# Used once by `npm run db:seed` to create the owner (Super Admin) account
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
